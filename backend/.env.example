# ChatLLM — Environment Variables
#
# Copy this file to .env and fill in the real values.
# NEVER commit the .env file to version control.
# NEVER hardcode secrets in source code.

# ── Application ──────────────────────────────────────────────────────────────
PROJECT_NAME=ChatLLM
ENVIRONMENT=development
API_V1_STR=/api/v1

# ── Database ─────────────────────────────────────────────────────────────────
# Use postgresql+asyncpg:// driver prefix for async SQLAlchemy operations
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── Security / JWT ───────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI Provider Keys ─────────────────────────────────────────────────────────
# All provider keys are optional in Phase 1.
# They will be required in Phase 9 (AI Gateway).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
